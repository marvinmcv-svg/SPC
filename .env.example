# Copy to .env.local. Every integration is optional; the site runs without them.

NEXT_PUBLIC_SITE_URL=https://www.spc-net.com
# ⚠️ No email is published today — confirm the inbox before launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp click-to-chat numbers, international format without "+", e.g. 16045551234
NEXT_PUBLIC_WHATSAPP_NUMBER_CA=
NEXT_PUBLIC_WHATSAPP_NUMBER_US=
NEXT_PUBLIC_WHATSAPP_NUMBER_AU=

# AI assistant (Anthropic API). Defaults to claude-sonnet-5-5 per the master plan.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Lead storage & routing
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HUBSPOT_TOKEN=
RESEND_API_KEY=
LEAD_EMAIL_FROM="SPC Website <website@spc-net.com>"
LEAD_EMAIL_DEFAULT=
LEAD_EMAIL_CA=
LEAD_EMAIL_US=
LEAD_EMAIL_AU=
LEAD_EMAIL_INTL=

# Booking, analytics, media
NEXT_PUBLIC_CALCOM_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Set to 1 to hide "to confirm" placeholder markers (screenshots only — replace placeholders before launch)
NEXT_PUBLIC_HIDE_VERIFY=
